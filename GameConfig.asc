// ============================================================================
// GameConfig.asc - Actual values and functions
// ============================================================================

import int igDarkness;

// ----------------------------------------------------------------------------
// DEFAULT-VALUES (Change your settings here)
// ----------------------------------------------------------------------------

// ShowHotspots-Settings
bool _hotspotShow           = true;       // default: true,  enables or disables hotspots
bool _hotspotAllCaps        = false;      // default: allcaps turned off
int _hotspotFadeDelay       = 1;          // Slow down effect by a delay: 1 = default speed, 2 = every second frame,  3 = every third frame,  etc.
FontType _hotspotFont       = eNullFont;  // -1 to disable text (eNullFont),  0 (eFontTumbleSpeech) - 4 (eFontXXXX) - requires AGS 3.6.2
int _hotspotIconSlot        = -1;         // default icon: drawn circle, select any sprite slot (number) to select a different icon
int _hotspotIconOffsetX     = 0;          // hotspot icon offset X - only applies to sprites
int _hotspotIconOffsetY     = 0;          // hotspot icon offset Y - only applies to sprites
int _hotspotKey             = eKeyTab;    // default key: 9 (Tab) - see https://adventuregamestudio.github.io/ags-manual/v3/Keycodes.html
int _hotspotColorR          = 220;        // Red   (0-255)
int _hotspotColorG          = 70;         // Green (0-255)
int _hotspotColorB          = 70;         // Blue  (0-255)
int _hotspotMaxTransparency = 35;         // 100 = fully transparent,  0 = not transparent (disables the effect)

// DO NOT CHANGE ANYTHING BELOW THIS LINE

// ----------------------------------------------------------------------------
// GETTER & SETTER (AGS 3.6 Attribute-access)
// ----------------------------------------------------------------------------

bool get_Enabled(this ShowHotspotsConfig*) {
  return _hotspotShow;
}
void set_Enabled(this ShowHotspotsConfig*, bool value) {
  _hotspotShow = value;
}

int get_FadeDelay(this ShowHotspotsConfig*) {
  return _hotspotFadeDelay;
}
void set_FadeDelay(this ShowHotspotsConfig*, int value) {
  _hotspotFadeDelay = value;
}

bool get_AllCaps(this ShowHotspotsConfig*) {
  return _hotspotAllCaps;
}
void set_AllCaps(this ShowHotspotsConfig*, bool value) {
  _hotspotAllCaps = value;
}

FontType get_Font(this ShowHotspotsConfig*) {
  return _hotspotFont;
}
void set_Font(this ShowHotspotsConfig*, FontType value) {
  _hotspotFont = value;
}

int get_IconSpriteSlot(this ShowHotspotsConfig*) {
  return _hotspotIconSlot;
}
void set_IconSpriteSlot(this ShowHotspotsConfig*, int value) {
  _hotspotIconSlot = value;
}

int get_IconOffsetX(this ShowHotspotsConfig*) {
  return _hotspotIconOffsetX;
}
void set_IconOffsetX(this ShowHotspotsConfig*, int value) {
  _hotspotIconOffsetX = value;
}

int get_IconOffsetY(this ShowHotspotsConfig*) {
  return _hotspotIconOffsetY;
}
void set_IconOffsetY(this ShowHotspotsConfig*, int value) {
  _hotspotIconOffsetY = value;
}

int get_HotSpotKey(this ShowHotspotsConfig*) {
  return _hotspotKey;
}
void set_HotSpotKey(this ShowHotspotsConfig*, int value) {
  _hotspotKey = value;
}

int geti_Color(this ShowHotspotsConfig*, int index) {
  if (index == 0) return _hotspotColorR;
  if (index == 1) return _hotspotColorG;
  if (index == 2) return _hotspotColorB;
  return 0; // Fallback
}
void seti_Color(this ShowHotspotsConfig*, int index, int value) {
  if      (index == 0) _hotspotColorR = value;
  else if (index == 1) _hotspotColorG = value;
  else if (index == 2) _hotspotColorB = value;
}

int get_MaxTransparency(this ShowHotspotsConfig*) {
  return _hotspotMaxTransparency;
}
void set_MaxTransparency(this ShowHotspotsConfig*, int value) {
  _hotspotMaxTransparency = value;
}

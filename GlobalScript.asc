// main global script file
// called when the game starts, before the first room is loaded

// =======================================================================================

#region Allgemein

function game_start() 
{
  SetRestartPoint();
  ShowHotspots.SetKey(eKeyH); // default key is space
  ShowHotspots.Enable();  
}

// put anything you want to happen every game cycle in here
function repeatedly_execute() 
{
}

// put here anything you want to happen every game cycle, even when the game is blocked
function repeatedly_execute_always() 
{
  // Check if the darkness GUI is active
  if (gDarkness.Visible) 
    {
        // Move the GUI button with the mouse cursor
        bFlashlight.X = mouse.x - (bFlashlight.Width / 2);
        bFlashlight.Y = mouse.y - (bFlashlight.Height / 2);
    }
  
  // Only Execute if AutoTracking is disabled
  if (!Game.Camera.AutoTracking)
  {
    // -------------------------------------------------------------
    // DYNAMIC CAMERA AND VIEWPORT SIZES
    // -------------------------------------------------------------
    int viewWidth = Game.Camera.Width;   // Get dynamic width, e. g. 320
    int viewHeight = Game.Camera.Height; // and height,  e. g. 124
    
    // -------------------------------------------------------------
    // SMOOTH SCROLLING SETTINGS
    // -------------------------------------------------------------
    // When should the scrolling start (in pixels) for the left/right und top/bottom borders
    int marginX = 90; 
    int marginY = 30; 

    // Scroll-speed (higher = faster, lower = smoother/slower)
    // Values between 0.1 (very smooth) and 0.3 (fast) are best
    float lerpSpeed = 0.2; 

    // Calculate current screen position of character
    int playerScreenX = player.x - Game.Camera.X;
    int playerScreenY = player.y - Game.Camera.Y;

    // Set target camera position to the current position
    int targetCamX = Game.Camera.X;
    int targetCamY = Game.Camera.Y;

    // --- RIGHT BORDER ---
    if (playerScreenX > (viewWidth - marginX)) {
      targetCamX = player.x - (viewWidth - marginX);
    }
    // --- LEFT BORDER ---
    else if (playerScreenX < marginX) {
      targetCamX = player.x - marginX;
    }
    // --- BOTTOM BORDER ---
    if (playerScreenY > (viewHeight - marginY)) {
      targetCamY = player.y - (viewHeight - marginY);
    }
    // --- TOP BORDER ---
    else if (playerScreenY < marginY) {
      targetCamY = player.y - marginY;
    }

    // Do not move the camera past the screen size
    int maxCamX = Room.Width - viewWidth;
    int maxCamY = Room.Height - viewHeight;

    if (targetCamX < 0) targetCamX = 0;
    if (targetCamX > maxCamX) targetCamX = maxCamX;
    if (targetCamY < 0) targetCamY = 0;
    if (targetCamY > maxCamY) targetCamY = maxCamY;

    // Dynamic Smooth Movement (Linear Interpolation)
    // Camera moves each frame closer to the target
    float currentX = IntToFloat(Game.Camera.X);
    float currentY = IntToFloat(Game.Camera.Y);
    float newX = currentX + (IntToFloat(targetCamX) - currentX) * lerpSpeed;
    float newY = currentY + (IntToFloat(targetCamY) - currentY) * lerpSpeed;

    // Set new camera position
    Game.Camera.X = FloatToInt(newX, eRoundNearest);
    Game.Camera.Y = FloatToInt(newY, eRoundNearest);
  }
}

void ShowOptions()
{
    Verbs.UpdateActionBar();
    OptionGui.ShowOptions();
}

// called when a key is pressed. keycode holds the key's ASCII code
function on_key_press(eKeyCode keycode, int mod) 
{
  if (keycode == eKeyF5) ShowOptions();
  if (keycode == eKeyF8) gRestart.Visible=true;
  if (keycode == eKeyF12)   SaveScreenShot("screenshot.png");  // F12
  if (mod & eKeyModCtrl)
  {
    if (keycode == eKeyC || keycode == eKeyQ) gQuit.Visible=true;  // Ctrl-C or CTRL-Q QUIT
    if (keycode == eKeyS) Debug(0,0); // Ctrl-S, give all inventory
    if (keycode == eKeyV) Debug(1,0); // Ctrl-V, version
    if (keycode == eKeyA) Debug(2,3); // Ctrl-A, show walkable areas
    if (keycode == eKeyX) Debug(3,0); // Ctrl-X, teleport to ro 
  }
}

function on_mouse_click(MouseButton button) // called when a mouse button is clicked. button is either LEFT or RIGHT 
{
}

function on_event(EventType event, int data) {
  if (event==eEventRestoreGame) {
    Verbs.Localize();
  }
  if (event==eEventEnterRoomBeforeFadein || event==eEventRestoreGame)
    player.PlaceOnWalkableArea();

  // Enable smooth scrolling, if required
  // eEventEnterRoomBeforeFadein is executed before entering each room
  if (event == eEventEnterRoomBeforeFadein)
  {
    // Check if room needs scrolling
    if (Room.Width > Game.Camera.Width || Room.Height > Game.Camera.Height)
    {
      // Disable AutoTracking, so smooth scrolling is active
      Game.Camera.AutoTracking = false;
    }
    else
    {
      // In smaller rooms, use default behaviour
      Game.Camera.AutoTracking = true;
    }
  }
}


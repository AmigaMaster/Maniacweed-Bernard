#region Room

/****************************
*   Room Functions
****************************/

function room_Load()
{
 if (giDarkness == 0) {
   gDarkness.Visible = false;
 }
 else {
  gDarkness.Visible = true;
 }
 
}

function room_FirstLoad()
{

}

function room_AfterFadeIn()
{

}

function room_Leave()
{
  if (giDarkness == 1) {
   gDarkness.Visible = false;
 }
 else {
  gDarkness.Visible = false;
 }
}

function room_RepExec()
{

}

#endregion


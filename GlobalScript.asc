function iFlashlight_OtherClick(InventoryItem *theItem, CursorMode mode)
{
  // LOOK AT
  if(Verbs.UsedAction(eGA_LookAt)) {
    player.Say("Eine Taschenlampe.");
  }
  // OPEN
  else if (Verbs.UsedAction(eGA_Open)) {
    player.Say("Mal sehen...");
    player.FaceDirection(eDirectionUp);
    for (int i = 0; i < 3; i++) {
      aCreak2.Play();
      Wait(GetGameSpeed() / 2);
    }
    Wait(GetGameSpeed() / 2);
    player.Say("Aha!");
    for (int i = 0; i < 3; i++) {
      aCreak2.Play();
      Wait(GetGameSpeed() / 2);
    }
    Wait(GetGameSpeed() / 2);
    player.FaceDirection(eDirectionDown);
    Wait(GetGameSpeed() / 2);
    player.Say("Es sind sogar Batterien drin.");
  }
  // USE
  else if(Verbs.UsedAction(eGA_Use)) {
    if (gDarkness.Visible == false) {
      player.Say("Ich brauche sie jetzt nicht.");
    }
    else if (gDarkness.BackgroundColor == 2113) {
      gDarkness.BackgroundColor = 0;
      gDarkness.BorderColor = 0;
      bFlashlight.Visible = true;
      iFlashlight.Name = "Taschenlampe (eingeschaltet)";
      aClick.Play();
    }
    else {
      gDarkness.BackgroundColor = 2113;
      gDarkness.BorderColor = 2113;
      bFlashlight.Visible = false;
      iFlashlight.Name = "Taschenlampe";
      aClick.Play();
    }
  }
  // Push
  else if(Verbs.UsedAction(eGA_Push)) {
    Verbs.Unhandled();
  }
  // Pull
  else if(Verbs.UsedAction(eGA_Pull)) {
    Verbs.Unhandled();
  }   
  //USE INV
  else if(Verbs.UsedAction(eGA_UseInv)) {
    Verbs.Unhandled();
  }
  else Verbs.Unhandled();
}

function iRemoteControl_OtherClick(InventoryItem *theItem, CursorMode mode)
{
  // LOOK AT
  if(Verbs.UsedAction(eGA_LookAt)) {
    cBernard.Say("Eines der wenigen Geräte, ...");
    cBernard.Say("... die selbst Britney bedienen kann.");
  }
  // USE
  else if(Verbs.UsedAction(eGA_Use)) {
    if (player.Room == BernLivingRoom)
    {
      aClick.Play();
      Wait(GetGameSpeed() / 4);
      gMain.Visible = false;
      gAction.Visible = false;
      mouse.Visible = false;
      aEtirwer__Looped_.Stop();
      player.ChangeRoom(BernTV);
    }
    else
    {
      player.Say("In diesen Raum funktioniert die Fernbedienung nicht.");
    }
  }
  // Push
  else if(Verbs.UsedAction(eGA_Push)) {
    Verbs.Unhandled();
  }
  // Pull
  else if(Verbs.UsedAction(eGA_Pull)) {
    Verbs.Unhandled();
  }   
  //USE INV
  else if(Verbs.UsedAction(eGA_UseInv)) {
    Verbs.Unhandled();
  }
  else Verbs.Unhandled();
}


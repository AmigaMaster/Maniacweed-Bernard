// Main script for module 'ShowHotspots'
#define MAX_HOTSPOTS 50

bool _showhotspots_enabled;

struct _hotspotinfo {
  int minx;
  int miny;
  int maxx;
  int maxy;
  int there;
};
_hotspotinfo _hi[MAX_HOTSPOTS];

int _showhotspots_key=-1;         // init variable
FontType _showhotspots_font=0;    // default font: 0
bool _showhotspots_allcaps=false; // default: allcaps turned off
int _custom_r = -1, _custom_g = -1,  _custom_b = -1;  // init variables for rgb color
int islot=-1;                     // default icon: drawn circle
int ox, oy;

// Fade effect
// Initial start values
int _fade_alpha = 0;
int _fade_step = 1;               // Transparency direction (1 = fade-out, -1 = fade-out)
int _fade_timer = 0;

//helper functions to get RGB value from GameConfig script
int _GetKeyCode() {
  if ( _showhotspots_key != -1) return _showhotspots_key;
  return ShowHotspotConfig.HotSpotKey;
}

int _GetR() {
  if (_custom_r != -1) return _custom_r;
  return ShowHotspotConfig.Color[0];
}

int _GetG() {
  if (_custom_g != -1) return _custom_g;
  return ShowHotspotConfig.Color[1];
}

int _GetB() {
  if (_custom_b != -1) return _custom_b;
  return ShowHotspotConfig.Color[2];
}

static function ShowHotspots::SetKey(eKeyCode keycode) {
  _showhotspots_key = keycode;
}

static function ShowHotspots::SetFont(FontType font, bool allcaps, int rr, int gg, int bb) {
  _showhotspots_font = font;
  _showhotspots_allcaps = allcaps;
  _custom_r = rr; 
  _custom_g = gg; 
  _custom_b = bb;
}

static function ShowHotspots::Enable() {
  _showhotspots_enabled = true;
}

static function ShowHotspots::Disable() {
  _showhotspots_enabled = false;
}

static function ShowHotspots::SetIcon(int slot, int xOffset, int yOffset) {
  islot = slot;
  ox = xOffset;
  oy = yOffset;
}

function noloopcheck _SearchHotspots() {
  for (int i = 0; i < MAX_HOTSPOTS; i++) {
    _hi[i].minx = Room.Width;  _hi[i].maxx = -1;
    _hi[i].miny = Room.Height; _hi[i].maxy = -1;
    _hi[i].there = false;
  }

  int ss = 4; // search step
  
  Hotspot* h;
  for (int y = 0; y < Room.Height; y += ss) {
    for (int x = 0; x < Room.Width; x += ss) {
      h = Hotspot.GetAtRoomXY(x, y);
      if (h.ID > 0 && h.Enabled) {
        int i = h.ID;
        _hi[i].there = true;
        if (x < _hi[i].minx) _hi[i].minx = x;
        if (x > _hi[i].maxx) _hi[i].maxx = x;
        if (y < _hi[i].miny) _hi[i].miny = y;
        if (y > _hi[i].maxy) _hi[i].maxy = y;
      }
    }
  }
}

String Umlaut(String s, String umlaut, String subs) {

  int up; // umlaut position
  
  while(up > -1) {
    up = s.Contains(umlaut);
    if (up > -1) s = String.Format("%s%s%s", s.Truncate(up), subs, s.Substring(up + 1, s.Length - 1 - up));
  }

  return s;
}

String Umlauts(String s) {

  s = Umlaut(s, "Ä", "Ae");
  s = Umlaut(s, "ä", "ae");
  s = Umlaut(s, "Ö", "Oe");
  s = Umlaut(s, "ö", "oe");
  s = Umlaut(s, "Ü", "Ue");
  s = Umlaut(s, "ü", "ue");
  
  return s;
}

DrawingSurface* drs;
Overlay* hotspotOverlay;
DynamicSprite* hotspotSprite;
FontType normalfont;
int last_room = -1;

function _DrawSpot(int x, int y, String name) {
  // Convert screen coordinates into camera coordinates
  x = x - Game.Camera.X;
  y = y - Game.Camera.Y;

  // Do not draw outside visible area
  if (x < 0 || x > Screen.Width || y < 0 || y > Screen.Height) return;

  drs.DrawingColor = Game.GetColorFromRGB(_GetR(), _GetG(), _GetB());
  if (islot == -1) drs.DrawCircle(x, y, 2);
  else drs.DrawImage(x - ox, y - oy, islot);
  
  if (_showhotspots_font == -1) return; // no captions
  if (name == "") return; // if there is no text, cancel here
  
  String s = name;
  if (s.Contains(">") > -1) s = s.Truncate(s.Length-2);
  s = Umlauts(s);
  if (_showhotspots_allcaps) s = s.UpperCase();
    
  int pox=4;
  int poy=3;
  
  int w = GetTextWidth(s, _showhotspots_font);
  int max_visible_x = Screen.Width;
  int cut_off = x + pox + w - max_visible_x + 2;
  if (cut_off > 0) pox -= cut_off;
  
  drs.DrawingColor = Game.GetColorFromRGB(1, 1, 1);
  
  int xx;
  int yy=-1;
  while (yy<2) {
    xx=-1;
    while (xx<2) {
      drs.DrawString(x+xx+pox, y+yy+poy, _showhotspots_font, s);
      xx++;
    }
    yy++;
  }
  drs.DrawingColor = Game.GetColorFromRGB(_GetR(), _GetG(), _GetB());
  drs.DrawString(x+pox, y+poy, _showhotspots_font,s);
}

bool is_showing_hotspots = false;
bool hotspot_last_state[MAX_HOTSPOTS];

function _ShowHotspots() {
  int x, y;
  int i;

  // Check if a hotspot has changed while pressing the hotkey
  bool needs_rescan = false;
  for (i = 1; i < MAX_HOTSPOTS; i++) {
    if (hotspot[i].Enabled != hotspot_last_state[i]) {
      needs_rescan = true;
    }
  }

  // Research for hotspots if room has changed
  if (last_room != player.Room || needs_rescan) {
    _SearchHotspots();
    last_room = player.Room;
    // Store current hotspot condition
    for (i = 1; i < MAX_HOTSPOTS; i++) {
      hotspot_last_state[i] = hotspot[i].Enabled;
    }
  }

  // objects
  Object* o;
  for (i = 0; i < Room.ObjectCount; i++) {
    o = object[i];
    if (o.Visible && o.Clickable) {
      x = (Game.SpriteWidth[o.Graphic])/2 + o.X;
      y = o.Y - (Game.SpriteHeight[o.Graphic]/2);
      _DrawSpot(x, y, "");
    }
  }

  // hotspots
  for (i = 1; i < MAX_HOTSPOTS; i++) {
    // Check if current hotspot is still enabled
    if (_hi[i].there && hotspot[i].Enabled) {
      x = (_hi[i].minx+_hi[i].maxx)/2;
      y = (_hi[i].miny+_hi[i].maxy)/2;
      _DrawSpot(x, y, "");
    }
  }
  
  // characters
  for (i = 0; i < Game.CharacterCount; i++) {
    Character* c = character[i];
    if (c != player && c.Room == player.Room && c.on) {
      ViewFrame* vf = Game.GetViewFrame(c.View, c.Loop, c.Frame);
      x = c.x;
      y = c.y - c.z - Game.SpriteHeight[vf.Graphic] / 2;
      _DrawSpot(x, y, "");
    }
  }
}

function _Prepare() {
  normalfont = Game.NormalFont;
  Game.NormalFont = _showhotspots_font;

  // Reset start values for transparency and timer
  _fade_alpha = 0;
  _fade_step = 1;
  _fade_timer = 0;

  // Create screen sized transparent sprite
  hotspotSprite = DynamicSprite.Create(Screen.Width, Screen.Height, true);
  
  // Create overlay
  hotspotOverlay = Overlay.CreateGraphical(0, 0, hotspotSprite.Graphic, true);
  hotspotOverlay.Transparency = _fade_alpha;
  
  // Search and update hotspot condition
  _SearchHotspots();
  last_room = player.Room;
  for (int i = 1; i < MAX_HOTSPOTS; i++) {
    hotspot_last_state[i] = hotspot[i].Enabled;
  }
}

function _CleanUp() {
  Game.NormalFont = normalfont;
  
  if (hotspotOverlay != null && hotspotOverlay.Valid) {
    hotspotOverlay.Remove();
  }
  
  if (hotspotSprite != null) {
    hotspotSprite.Delete();
  }
}

function repeatedly_execute_always() {
  if (!_showhotspots_enabled) return;

  if (IsKeyPressed(_GetKeyCode())) {
    
    // Prepare overlay if hotkey is pressed
    if (!is_showing_hotspots) {
      is_showing_hotspots = true;
      _Prepare();
    }

    // Start fade-in and fade-out
    _fade_timer++;
    if (_fade_timer >= ShowHotspotConfig.FadeDelay) {
      _fade_timer = 0;
      
      _fade_alpha += _fade_step;
      
      if (_fade_alpha >= ShowHotspotConfig.MaxTransparency) {      
        _fade_alpha = ShowHotspotConfig.MaxTransparency;
        _fade_step = -1;       // Switch to fade-in
      } 
      else if (_fade_alpha <= 0) {   
        _fade_alpha = 0;
        _fade_step = 1;        // Switch to fade-out
      }
      
      if (hotspotOverlay != null && hotspotOverlay.Valid) {
        hotspotOverlay.Transparency = _fade_alpha;
      }
    }

    // Redraw Overlay for each frame
    drs = hotspotSprite.GetDrawingSurface();
    drs.Clear(COLOR_TRANSPARENT);
    _ShowHotspots();
    drs.Release();
    
  } 
  else {
    // Clean up is hotkey is released
    if (is_showing_hotspots) {
      is_showing_hotspots = false;
      _CleanUp();
    }
  }
}
// ============================================================================
// GameConfig.asc - Actual values and functions
// ============================================================================

import int igDarkness;

// ----------------------------------------------------------------------------
// DEFAULT-VALUES (Change your settings here)
// ----------------------------------------------------------------------------

// Hotspot-Settings
bool _showhotspots        = true;       // default: true,  enables or disables hotspots
int _fade_delay           = 1;          // Slow down effect by a delay: 1 = default speed, 2 = every second frame,  3 = every third frame,  etc.
bool _hotspotAllCaps      = false;      // default: allcaps turned off
FontType _hotspotFont     = eNullFont;  // -1 to disable text (eNullFont),  0 (eFontTumbleSpeech) - 4 (eFontXXXX) - requires AGS 3.6.2
int _hotspotIconSlot      = -1;         // default icon: drawn circle,  select any sprite slot (number) to select a different icon
int _hotspotIconOffsetX   = 0;          // hotspot icon offset X - only applies to sprites
int _hotspotIconOffsetY   = 0;          // hotspot icon offset Y - only applies to sprites
int _hotspotKey           = eKeyTab;    // default key: 9 (Tab) - see https://adventuregamestudio.github.io/ags-manual/v3/Keycodes.html
int _hotspotColorR        = 220;        // Red   (0-255)
int _hotspotColorG        = 70;         // Green (0-255)
int _hotspotColorB        = 70;         // Blue  (0-255)
int _max_transparency     = 35;         // 100 = fully transparent,  0 = not transparent (disables the effect)

// DO NOT CHANGE ANYTHING BELOW THIS LINE

// ----------------------------------------------------------------------------
// GETTER & SETTER (AGS 3.6 Attribute-access)
// ----------------------------------------------------------------------------

bool get_Enabled(this ShowHotspotConfig*) {
  return _showhotspots;
}
void set_Enabled(this ShowHotspotConfig*, bool value) {
  _showhotspots = value;
}

int get_FadeDelay(this ShowHotspotConfig*) {
  return _fade_delay;
}
void set_FadeDelay(this ShowHotspotConfig*, int value) {
  _fade_delay = value;
}

bool get_AllCaps(this ShowHotspotConfig*) {
  return _hotspotAllCaps;
}
void set_AllCaps(this ShowHotspotConfig*, bool value) {
  _hotspotAllCaps = value;
}

FontType get_Font(this ShowHotspotConfig*) {
  return _hotspotFont;
}
void set_Font(this ShowHotspotConfig*, FontType value) {
  _hotspotFont = value;
}

int get_IconSpriteSlot(this ShowHotspotConfig*) {
  return _hotspotIconSlot;
}
void set_IconSpriteSlot(this ShowHotspotConfig*, int value) {
  _hotspotIconSlot = value;
}

int get_IconOffsetX(this ShowHotspotConfig*) {
  return _hotspotIconOffsetX;
}
void set_IconOffsetX(this ShowHotspotConfig*, int value) {
  _hotspotIconOffsetX = value;
}

int get_IconOffsetY(this ShowHotspotConfig*) {
  return _hotspotIconOffsetY;
}
void set_IconOffsetY(this ShowHotspotConfig*, int value) {
  _hotspotIconOffsetY = value;
}

int get_HotSpotKey(this ShowHotspotConfig*) {
  return _hotspotKey;
}
void set_HotSpotKey(this ShowHotspotConfig*, int value) {
  _hotspotKey = value;
}

int geti_Color(this ShowHotspotConfig*, int index) {
  if (index == 0) return _hotspotColorR;
  if (index == 1) return _hotspotColorG;
  if (index == 2) return _hotspotColorB;
  return 0; // Fallback
}
void seti_Color(this ShowHotspotConfig*, int index, int value) {
  if      (index == 0) _hotspotColorR = value;
  else if (index == 1) _hotspotColorG = value;
  else if (index == 2) _hotspotColorB = value;
}

int get_MaxTransparency(this ShowHotspotConfig*) {
  return _max_transparency;
}
void set_MaxTransparency(this ShowHotspotConfig*, int value) {
  _max_transparency = value;
}

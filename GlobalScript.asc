#region Change Player

function CharacterSwitch (const string OnOff)
{
  if (OnOff == "On")
  {
    gCharaktere.Visible = true;
    invMain.Width = 120;
  }
  else if (OnOff == "Off") 
  {
    gCharaktere.Visible = false;
    invMain.Width = 160;
  }  
}

